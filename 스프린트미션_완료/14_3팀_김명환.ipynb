        "    original_chunk_index: Optional[int] = None  # 요약본의 경우 원본 청크 인덱스\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class SearchResult:\n",
        "    \"\"\"검색 결과\"\"\"\n",
        "    content: str # 청크 내용\n",
        "    file_name: str # 파일명만\n",
        "    page: int # 페이지 번호\n",
        "    score: float # 유사도\n",
        "    chunk_type: str # 청크 유형\n",
        "\n"
      ]
    },
